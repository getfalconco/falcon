# Copy to .env.desktop for desktop builds (bundled into the installer).
# Do not commit .env.desktop — it may contain API keys.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o
PERPLEXITY_API_KEY=pplx-your_key_here
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_VERIFY_MODEL=sonar-reasoning-pro
# MASSIVE_API_KEY=your_massive_api_key_here
# MARKET_DATA_PROVIDER_ORDER=massive

# Where the always-on chain (Tracker → Classifier → Base → Propagation) runs.
# Point this at the falcon-engine service. Without it the app reads nothing and
# analyses nothing — which is deliberate: a second chain competes with the
# service for the same shared Finnhub free tier and Anthropic budget.
FALCON_ENGINE_URL=https://your-engine.up.railway.app
# Set to 1 ONLY to deliberately own the chain on this machine (spends the
# shared provider quotas). Leave unset otherwise.
# FALCON_LOCAL_CHAIN=1

# ---------------------------------------------------------------------------
# Which provider each engine talks to
# ---------------------------------------------------------------------------
# The chain is split on purpose. The classifier and step1 read public filings
# and published news, so a free model costs nothing to try and leaks nothing.
# The propagation judge is the product's reasoning and the Insight write-up is
# its only user-facing prose — those stay on Claude.
#
# OpenRouter needs no new client: /api/v1/messages answers in Anthropic's wire
# format, so this is a base-URL swap.

# Engines to route to OpenRouter. Anything not listed uses ANTHROPIC_* below.
FALCON_OPENROUTER_ENGINES=classifier,step1
FALCON_OPENROUTER_KEY=
# Defaults to https://openrouter.ai/api/v1 — only set to override.
# FALCON_OPENROUTER_BASE_URL=

# Claude, for the two that stay. A real sk-ant- key, no gateway.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=   # leave unset for api.anthropic.com

# Per-stage step1 models: extraction reads a 24k chunk and must emit strict
# JSONL; audit judges a few candidates against passages; strength answers one
# enum. Only the first needs a capable model.
# Stored config wins over the seed once a volume exists, so the model has to be
# said by the deployment.
FALCON_CLASSIFIER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

FALCON_STEP1_EXTRACT_MODEL=z-ai/glm-5.2:free
FALCON_STEP1_AUDIT_MODEL=dots-studio/dots-3-note-preview:free
FALCON_STEP1_STRENGTH_MODEL=nvidia/nemotron-3-super-120b-a12b:free
