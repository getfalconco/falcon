{
  "name": "falcon",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "packageExtensions": {
      "next@14": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "lucide-react": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "framer-motion": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "@react-three/fiber": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "@tabler/icons-react": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      }
    }
  },
  "scripts": {
    "postinstall": "node scripts/install-git-hooks.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "turbo run dev --filter=web",
    "build:web": "turbo run build --filter=web",
    "start:web": "pnpm --filter web start",
    "dev:mobile": "pnpm --filter mobile web",
    "mobile": "pnpm --filter mobile",
    "sightings": "pnpm --filter @falcon/engine run sightings"
  },
  "devDependencies": {
    "turbo": "^2.9.16"
  }
}
