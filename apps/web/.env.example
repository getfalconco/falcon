# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://jjixbyafhpyzfvbxapov.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — server only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres pooler (server / desktop main only)
DATABASE_URL=postgresql://postgres.jjixbyafhpyzfvbxapov:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Admin panel credentials (server only)
ADMIN_EMAIL=falcon@getfalcon.co
ADMIN_PASSWORD=change-me

# Used to sign admin session cookies — generate a long random string
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Resend (server only) — send from verified @getfalcon.co domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@getfalcon.co
RESEND_FROM_NAME=Falcon

# Desktop installer URLs (public — safe for browser)
NEXT_PUBLIC_MAC_DOWNLOAD_URL=
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=

# Falcon error-log Discord (server only — /api/falcon-error). Never NEXT_PUBLIC_*.
# Same URL as research-worker / repo-root .env. Alias is for Netlify if the
# worker name isn't set there yet. Do not use DISCORD_WEBHOOK_URL (git logs).
DISCORD_ERROR_LOG_WEBHOOK_URL=
FALCON_ERROR_LOG_WEBHOOK_URL=
# ---------------------------------------------------------------------------
# API usage panel (/admin/dashboard/api-usage) — server only, never NEXT_PUBLIC_*
# ---------------------------------------------------------------------------
# Falcon's model traffic does NOT bill to Anthropic. Every service reports
# upstreamHost=api.oneprovider.dev, keyKind=gateway, so production spend and the
# balance that can actually run out live at the gateway. These are two separate
# accounts and the panel keeps them apart on purpose.

# The gateway Falcon actually bills against — same key the engine and
# research-worker use on Railway (ANTHROPIC_API_KEY there). Falls back to
# ANTHROPIC_API_KEY here if unset.
FALCON_GATEWAY_KEY=
# Only needed if the gateway moves; defaults to https://api.oneprovider.dev
FALCON_GATEWAY_BASE_URL=

# The direct Anthropic org key — developer tooling, not Falcon's production
# traffic. Must be an ADMIN key (sk-ant-admin…) or an org-scoped key: the Usage
# & Cost endpoints reject workspace-scoped keys with a 401.
ANTHROPIC_ADMIN_KEY=

# Read for the engine strip (uptime, tracked tickers, which host it bills to).
# Defaults to https://falcon-engine-production.up.railway.app
FALCON_ENGINE_URL=
