
RESEARCH_TIER=institutional
GRAPH_MIN_NODES=50
GRAPH_RETRY_ENABLED=true
PRIOR_CONTEXT_MAX_CHARS=32000
RESEARCH_REQUIRE_WEB=false

# Claude API (step1, and the /api/anthropic proxy packaged desktops call through).
# An sk-ant- key from the Claude Console. Calls go to https://api.anthropic.com;
# ANTHROPIC_BASE_URL is an optional override for a gateway.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# FALCON_MODEL=claude-sonnet-4-5

# SEC EDGAR User-Agent (required)
SEC_USER_AGENT=Meridian research@meridian.app

# Worker
PORT=8787
HOST=0.0.0.0
# RESEARCH_WORKER_URL is for the desktop app (apps/desktop/.env), not this process.

# SnapTrade (brokerage connect). Same keys as apps/desktop/.env.local.
# Locally the worker also reads those keys from desktop .env.local if unset.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Encrypts the SnapTrade user secret in public.snaptrade_secrets (AES-256-GCM).
# 32 bytes as 64 hex chars or base64: `openssl rand -base64 32`. Without it the
# worker keeps working on plaintext secrets and logs a warning. Plaintext rows
# are re-encrypted the next time they are read once this is set. Never rotate
# it by replacing the value: rows sealed with the old key would stop opening.
SNAPTRADE_SECRET_KEY=

# Falcon error-log Discord channel (job/engine failures). Git push/pull uses
# DISCORD_WEBHOOK_URL in the repo-root .env instead — do not reuse that URL here.
DISCORD_ERROR_LOG_WEBHOOK_URL=
# Salt for the hashed account id on error-log lines (u_<12 hex>). At least 16
# characters, e.g. `openssl rand -hex 16`; use the SAME value as the website
# (apps/web) so one account reads the same from both. Without it: masked email
# (k***@yahoo.com) instead. Names and full addresses are never posted.
ERROR_LOG_ID_SALT=

# Account deletion erases the account's risk data on the engine through
# POST $FALCON_ENGINE_URL/service/delete-user-data. FALCON_ENGINE_SERVICE_TOKEN
# is a shared secret (32+ random chars, `openssl rand -hex 32`): set the SAME
# value on the falcon-engine service. Without both, deletion reports the engine
# data as "unavailable" (the desktop still erases it with the user's session).
FALCON_ENGINE_URL=
FALCON_ENGINE_SERVICE_TOKEN=
