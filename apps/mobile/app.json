{
  "expo": {
    "name": "Falcon",
    "slug": "falcon",
    "scheme": "falcon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "co.getfalcon.app",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "co.getfalcon.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 64,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Falcon reads a screenshot of your positions to find your holdings.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
