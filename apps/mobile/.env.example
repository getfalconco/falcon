# Copy to .env (gitignored). Same Supabase project as apps/web (NEXT_PUBLIC_SUPABASE_*).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Website that serves the API routes (tickers, filings, portfolio).
EXPO_PUBLIC_API_URL=https://getfalcon.co
# Funnel test mode: 0 (default) keeps the session and saves answers; 1 keeps no
# session and saves no answers, so the funnel can be run again and again.
EXPO_PUBLIC_FUNNEL_TEST_MODE=0
