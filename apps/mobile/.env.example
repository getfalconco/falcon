# Expo public env — copy to `.env` (gitignored).
EXPO_PUBLIC_SUPABASE_URL=https://jjixbyafhpyzfvbxapov.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SITE_URL=https://getfalcon.co
# Same Step-1 engine desktop uses.
# Production (phone without a local worker):
#   EXPO_PUBLIC_API_URL=https://research-worker-production-c17d.up.railway.app
# Local dev (`pnpm dev:research-worker` on the Mac):
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
# Loopback is rewritten to the Expo / Mac LAN IP on a physical device (port 8787 kept).
EXPO_PUBLIC_API_URL=https://research-worker-production-c17d.up.railway.app
# Optional override if Expo hostUri is empty (otherwise app.config.js bakes en0).
# EXPO_PUBLIC_COMPUTE_LAN_HOST=10.0.0.27

# The always-on engine service (apps/falcon-engine) — the propagation runs the
# Insight card reads. Same box the desktop points FALCON_ENGINE_URL at.
# Local dev (`pnpm --filter falcon-engine dev` on the Mac): http://127.0.0.1:8788
EXPO_PUBLIC_ENGINE_URL=https://falcon-engine-production.up.railway.app
