# Copy to .env (gitignored). Same Supabase project as apps/web (NEXT_PUBLIC_SUPABASE_*).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Website that serves the API routes (tickers, filings, portfolio).
EXPO_PUBLIC_API_URL=https://getfalcon.co
# Funnel test mode: 1 (default) keeps no session and saves no answers; 0 turns it off.
EXPO_PUBLIC_FUNNEL_TEST_MODE=1
