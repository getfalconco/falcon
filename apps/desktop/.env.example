# Supabase Auth (renderer — safe to expose anon key)
# In Supabase Dashboard: Authentication → Providers → Email → enable "Confirm email"
# Paste token-only templates from emails/supabase/ into Authentication → Email Templates
VITE_SUPABASE_URL=https://jjixbyafhpyzfvbxapov.supabase.co
VITE_SUPABASE_ANON_KEY=

# Direct Postgres pooler (main process / server only — never ship to renderer)
DATABASE_URL=postgresql://postgres.jjixbyafhpyzfvbxapov:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Shared Step-1 compute API (same process mobile uses). If unset or unreachable,
# desktop falls back to running Step-1 in the Electron main process.
# RESEARCH_WORKER_URL=http://127.0.0.1:8787

# AI research (main process / research-worker only — never ship to renderer)
# ANTHROPIC_API_KEY=
# FALCON_MODEL=claude-sonnet-4-6
# SEC_USER_AGENT=Falcon Research dev@joinfalcon.ai
# OPENAI_API_KEY=
# PERPLEXITY_API_KEY=
# Put MASSIVE_API_KEY in apps/desktop/.env.local (gitignored) — tracked .env is pushed to GitHub.
# MASSIVE_API_KEY=

# Shared daily dashboard signal (main process — same signal for all users per day)
# SUPABASE_URL=https://jjixbyafhpyzfvbxapov.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Run apps/desktop/supabase/daily_top_signals.sql once in Supabase SQL editor.
# tracking_agents is auto-created on app start when DATABASE_URL is set (or run: pnpm migrate:tracking-agents)

# Required for Upcoming Calendar earnings. Economic/macros also use free TradingView +
# Federal Reserve calendars when Finnhub economic is blocked (free-tier 403) or FMP is unset.
# FINNHUB_API_KEY=
# FMP_API_KEY=

# Rolling Market Intelligence (dashboard) — keep on sonar-pro. Deep research is too slow.
# DISCOVERY_RESEARCH_MODEL=sonar-pro
# DISCOVERY_SYNTHESIS_MODEL=sonar-pro
# DISCOVERY_MAX_ATTEMPTS=2
# DISCOVERY_REASONING_EFFORT=low
# DISCOVERY_SEARCH_CONTEXT_SIZE=medium
# DISCOVERY_MAX_TOKENS=8000
# SIGNAL_RESEARCH_MODEL=sonar-pro
# ANALYSIS_MODEL=gpt-4o
# SIGNAL_ANALYSIS_MAX_TOKENS=1200
# Opt-in only (not for dashboard load): DISCOVERY_RESEARCH_MODEL=sonar-deep-research
