OPENAI_API_KEY=your_api_key_here

# Accuracy-first models (separate API billing from ChatGPT Plus)
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o
# OPENAI_PASS_DELAY_MS=500
# PRIOR_CONTEXT_MAX_CHARS=24000

# Perplexity Sonar — live web search grounding (required for best accuracy)
PERPLEXITY_API_KEY=pplx-your_key_here
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_VERIFY_MODEL=sonar-reasoning-pro
PERPLEXITY_DEEP_MODEL=sonar-deep-research

# Institutional research tier (default: institutional — 12+ web queries, Pass 0/6/7 audit)
RESEARCH_TIER=institutional
OPENAI_MODEL_REASONING=gpt-4o
GRAPH_MIN_NODES=50
GRAPH_RETRY_ENABLED=true
PRIOR_CONTEXT_MAX_CHARS=32000
# RESEARCH_REQUIRE_WEB=true

# Desktop installer (copy to .env.desktop — bundled at build time, do not commit):
# cp .env.local .env.desktop

# Massive.com market data (formerly Polygon.io) — recommended for accurate prices
# MASSIVE_API_KEY=your_massive_api_key_here
# POLYGON_API_KEY=your_key_here
# MARKET_DATA_PROVIDER_ORDER=massive,polygon,finnhub,fmp,alpha_vantage,yahoo

# Other optional market data providers
# FINNHUB_API_KEY=
# FMP_API_KEY=
# ALPHA_VANTAGE_API_KEY=
